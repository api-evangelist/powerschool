              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "schoolDcid",
                  "description": "(Required) The school's DCID (not school number or ID)"
                },
                {
                  "description": "The subdomain of the school district's PowerSchool installation",
                  "type": "any",
                  "value": "{{district}}",
