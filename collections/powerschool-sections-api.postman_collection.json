                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for paginated results (1-indexed)."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Filter expression using FIQL-like syntax. Example: id=ge=10000 to filter records with id >= 10000."
