          "name": "Execute a named PowerQuery",
          "request": {
            "name": "Execute a named PowerQuery",
            "description": {
              "content": "Executes a named PowerQuery to retrieve complex data sets. PowerQueries are predefined server-side queries identified by a dotted namespace string (e.g., com.pearson.core.teachers.sectionEnrollments). The request body provides filter parameters specific to each query.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ws",
                "schema",
                "query",
                ":queryName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pagesize",
                  "value": "100",
                  "description": "Number of records to return per page."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for paginated results (1-indexed)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "queryName",
                  "description": "(Required) The fully-qualified PowerQuery name (e.g., com.pearson.core.teachers.sectionEnrollments)"
                },
                {
                  "description": "The subdomain of the school district's PowerSchool installation",
                  "type": "any",
                  "value": "{{district}}",
                  "key": "district"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
